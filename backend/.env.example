# FastAPI
FRONTEND_ORIGIN=http://localhost:5173
BACKEND_PUBLIC_URL=http://localhost:8000
# Render에서 settings/site-content.json으로 설정하면 관리자 설정이 Supabase에 보존됩니다.
SITE_CONTENT_STORAGE_PATH=

# Supabase (비워두면 demo 메모리 저장소로 동작합니다.)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# AI (선택)
# OPENAI_API_KEY=

# 관리자 전용. 암호와 서명 키는 서로 다르게 길게 설정합니다.
ADMIN_PASSWORD=
ADMIN_SIGNING_KEY=
